<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ElephantNote.Avalonia.App">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
    </Style>
    <Style Selector="Button.rail-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.rail-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.rail-button.active">
      <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>
    <Style Selector="Button.primary-button">
      <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource AppSoftBrush}" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppSidebarBrush" Color="#EDF2F7" />
    <SolidColorBrush x:Key="AppSoftBrush" Color="#E9EFF7" />
    <SolidColorBrush x:Key="AppSelectionBrush" Color="#DCE9FF" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#C5CFDD" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#101828" />
    <SolidColorBrush x:Key="AppMutedBrush" Color="#667085" />
    <SolidColorBrush x:Key="AppPrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="#DC2626" />
  </Application.Resources>
</Application>
