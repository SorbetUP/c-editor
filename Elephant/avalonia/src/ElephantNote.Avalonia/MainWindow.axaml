<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:muya="using:ElephantNote.Avalonia.Muya"
        x:Class="ElephantNote.Avalonia.MainWindow"
        x:CompileBindings="False"
        Width="1280"
        Height="840"
        MinWidth="960"
        MinHeight="620"
        Title="{Binding WindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="●" Foreground="{DynamicResource AppPrimaryBrush}" FontSize="20" VerticalAlignment="Center" />
          <TextBlock Text="{Binding VaultName}" Foreground="{DynamicResource AppTextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBox Grid.Column="1" MaxWidth="540" HorizontalAlignment="Center" PlaceholderText="Search notes" Text="{Binding SearchQuery, Mode=TwoWay}" KeyDown="SearchKeyDown" AutomationProperties.Name="Search notes" AutomationProperties.AutomationId="search-notes" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="Search" Click="SearchClick" />
          <Button Content="Settings" Click="SettingsClick" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="72,248,*">
      <Border Grid.Column="0" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="8,14">
        <StackPanel Spacing="8">
          <Button Classes="rail-button active" Content="▦&#x0a;Notes" Tag="notes" Click="RailClick" ToolTip.Tip="Notes" />
          <Button Classes="rail-button" Content="⌂&#x0a;Home" Tag="dashboard" Click="RailClick" ToolTip.Tip="Dashboard" />
          <Button Classes="rail-button" Content="◇&#x0a;Wiki" Tag="wiki" Click="RailClick" ToolTip.Tip="Wiki" />
          <Button Classes="rail-button" Content="◌&#x0a;Graph" Tag="graph" Click="RailClick" ToolTip.Tip="Graph" />
          <Button Classes="rail-button" Content="✦&#x0a;AI" Tag="models" Click="RailClick" ToolTip.Tip="AI models" />
          <Button Classes="rail-button" Content="☁&#x0a;Chat" Tag="chat" Click="RailClick" ToolTip.Tip="Chat" />
          <Separator Margin="4,8" />
          <Button Classes="rail-button" Content="⚙&#x0a;Prefs" Tag="settings" Click="RailClick" ToolTip.Tip="Settings" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="10,14">
        <Grid RowDefinitions="Auto,Auto,*">
          <Button Content="▣  All notes" HorizontalContentAlignment="Left" Background="{DynamicResource AppSoftBrush}" Click="AllNotesClick" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,22,4,8">
            <TextBlock Text="NOTES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="⌕" Padding="6,2" Click="SearchClick" ToolTip.Tip="Search notes" />
          </Grid>
          <ListBox Grid.Row="2" ItemsSource="{Binding SidebarEntries}" SelectionChanged="SidebarSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="8,7" CornerRadius="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Glyph}" Foreground="{DynamicResource AppMutedBrush}" />
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid Grid.Column="2" Background="{DynamicResource AppBackgroundBrush}">
        <Grid IsVisible="{Binding IsEmptyVaultVisible}" HorizontalAlignment="Center" VerticalAlignment="Center" RowDefinitions="Auto,Auto,Auto" Width="430">
          <TextBlock Text="Open a vault to start writing" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" HorizontalAlignment="Center" />
          <TextBlock Grid.Row="1" Text="Elephant stores notes as ordinary Markdown files in a local folder." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,22" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
          <Button Classes="primary-button" Content="Open vault" Click="ChooseVaultClick" AutomationProperties.Name="Open vault" AutomationProperties.AutomationId="open-vault" />
            <Button Content="Create vault folder" Click="CreateVaultClick" AutomationProperties.Name="Create vault folder" AutomationProperties.AutomationId="create-vault" />
          </StackPanel>
        </Grid>

        <Grid IsVisible="{Binding IsWorkspaceVisible}" RowDefinitions="Auto,*">
          <Border Padding="22,20,22,12" Background="{DynamicResource AppBackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="{Binding CurrentHeading}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Text="{Binding CurrentSubheading}" Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="New folder" Click="CreateFolderClick" />
                <Button Classes="primary-button" Content="+ New note" Click="CreateNoteClick" AutomationProperties.Name="New note" AutomationProperties.AutomationId="new-note" />
              </StackPanel>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" SelectionChanged="EntrySelectionChanged" Margin="22,4,22,22">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemWidth="270" ItemHeight="132" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,12">
                  <Grid RowDefinitions="Auto,*,Auto" Width="240">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Glyph}" Foreground="{DynamicResource AppPrimaryBrush}" FontSize="18" />
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Preview}" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" TextTrimming="WordEllipsis" Margin="0,10,0,4" />
                    <TextBlock Grid.Row="2" Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <Grid IsVisible="{Binding IsEditorVisible}" RowDefinitions="Auto,*,Auto" Margin="30,22,30,20">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel>
              <TextBlock Text="{Binding NoteTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
              <TextBlock Text="{Binding OpenedNotePath}" Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
              <Button Grid.Column="1" Content="← Back to notes" Click="BackToNotesClick" AutomationProperties.Name="Back to notes" AutomationProperties.AutomationId="back-to-notes" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,20,0,14">
            <Border IsVisible="{Binding IsMuyaEditorVisible}" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
              <muya:AvaloniaMuyaWebView x:Name="MuyaWebView" AutomationProperties.Name="Muya Markdown editor" AutomationProperties.AutomationId="muya-editor" />
            </Border>
            <TextBox IsVisible="{Binding IsNativeEditorFallbackVisible}" Text="{Binding NoteContent, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="DejaVu Sans Mono, Consolas, monospace" FontSize="15" Padding="18" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" AutomationProperties.Name="Markdown editor fallback" AutomationProperties.AutomationId="markdown-editor-fallback" />
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="primary-button" Content="Save note" Click="SaveNoteClick" AutomationProperties.Name="Save note" AutomationProperties.AutomationId="save-note" />
          </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsSearchVisible}" RowDefinitions="Auto,*" Margin="30,22,30,20">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding SearchQuery, Mode=TwoWay}" PlaceholderText="Search the active vault" KeyDown="SearchKeyDown" />
            <Button Grid.Column="1" Classes="primary-button" Content="Search" Click="SearchClick" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" Margin="0,18,0,0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="14" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                  <StackPanel Spacing="5">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
                    <TextBlock Text="{Binding Excerpt}" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <Grid IsVisible="{Binding IsSettingsVisible}" Margin="30,22,30,20" RowDefinitions="Auto,*">
          <StackPanel>
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
            <TextBlock Text="Native preferences reuse the shared JSON contract and preserve unknown keys." Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="16" MaxWidth="680" Margin="0,26,0,0">
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Theme" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                  <TextBlock Text="Choose the native light or dark chrome." Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" Width="130" />
              </Grid>
            </Border>
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Autosave" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                  <TextBlock Text="Keep the edited Markdown file synchronized after a save action." Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoSave, Mode=TwoWay}" />
              </Grid>
            </Border>
            <Border Background="{DynamicResource AppSoftBrush}" CornerRadius="10" Padding="18">
              <StackPanel Spacing="6">
                <TextBlock Text="Migration status" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock Text="Notes, folders, local Markdown editing, vault persistence and text search are connected. Addons, Excalidraw, graph, calendar and AI still require native adapters." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Grid IsVisible="{Binding IsUnsupportedSurfaceVisible}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
          <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="26">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding ActiveSurfaceTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
              <TextBlock Text="{Binding ActiveSurfaceMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" />
              <Button Content="Return to notes" HorizontalAlignment="Left" Click="AllNotesClick" />
            </StackPanel>
          </Border>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="22,0,0,12" Background="{DynamicResource AppSoftBrush}" CornerRadius="6" Padding="8,4" IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap" MaxWidth="580" />
        </Border>
      </Grid>
    </Grid>
    </Grid>
  </Grid>
</Window>
